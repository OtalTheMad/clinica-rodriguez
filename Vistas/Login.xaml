<Window x:Class="ClinicaRodriguez.Vistas.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClinicaRodriguez.Vistas"
        xmlns:VistaModelos="clr-namespace:ClinicaRodriguez.VistaModelos"
        mc:Ignorable="d"
        Title="Iniciar Sesión" Height="450" Width="800">

    <Window.DataContext>
        <VistaModelos:LoginVM/>
    </Window.DataContext>

    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF8892F1" Offset="0"/>
                <GradientStop Color="#FF898FD0" Offset="0.4"/>
                <GradientStop Color="#FF808EFF" Offset="0.7"/>
                <GradientStop Color="#FF171D67" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border BorderBrush="#FF8892F1" CornerRadius="6" BorderThickness="2">
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.Background>
                    <SolidColorBrush Color="White"/>
                </Grid.Background>

                <Grid.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="36"/>
                    </Style>
                </Grid.Resources>

                <Label Content="Iniciar Sesión" Grid.Row="0" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe UI" FontSize="36"/>
                <Image Grid.Row="1" HorizontalAlignment="Left" Height="32" Width="32" Margin="40,0,0,0" Source="/usuario.png"/>
                <TextBox x:Name="userNombre" Grid.Row="1"
                     Text="{Binding _nombreUsuario}"
                     HorizontalAlignment="Center"
                     TextWrapping="Wrap"
                     Width="242" Height="32"
                     Background="#F0F0F0"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     Padding="8,5">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <Image Grid.Row="2" HorizontalAlignment="Left" Height="32" Margin="40,0,0,0" Source="/contrasena.png"/>
                <PasswordBox x:Name="userClave" HorizontalAlignment="Center" Grid.Row="2" 
                         PasswordChanged="userClave_PasswordChanged"
                         Background="#F0F0F0"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         Padding="8,5" Width="242" Height="32">
                    <PasswordBox.Style>
                        <Style TargetType="{x:Type PasswordBox}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                                        <Border x:Name="border" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>

                <Button x:Name="btnLogin" Content="Iniciar Sesión" 
                    Command="{Binding ComandoLogin}"
                    Grid.Row="3" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    FontFamily="Segoe UI" 
                    FontWeight="Bold"
                    FontSize="18"
                    Padding="8,5" Foreground="White">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                    <Button.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FF5E66C3" Offset="0"/>
                            <GradientStop Color="#FF5F6FF3" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Image Grid.Column="1" HorizontalAlignment="Center" Height="96" Grid.RowSpan="2" VerticalAlignment="Center" Width="352" Source="/Recursos/img/logo_1.png" StretchDirection="DownOnly"/>
        </Grid>

    </Grid>
</Window>
