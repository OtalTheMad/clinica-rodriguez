<Window x:Class="ClinicaRodriguez.Vistas.MenuPrincipalOdontologia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClinicaRodriguez.Vistas"
        mc:Ignorable="d"
        Title="Clínica Rodríguez" Height="600" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF8892F1" Offset="0"/>
                <GradientStop Color="#FF898FD0" Offset="0.4"/>
                <GradientStop Color="#FF808EFF" Offset="0.7"/>
                <GradientStop Color="#FF171D67" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Stretch">
            <StackPanel.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF8892F1" Offset="0"/>
                    <GradientStop Color="#FF898FD0" Offset="0.4"/>
                    <GradientStop Color="#FF808EFF" Offset="0.7"/>
                    <GradientStop Color="#FF171D67" Offset="1"/>
                </LinearGradientBrush>
            </StackPanel.Background>

            <TextBlock Text="Menú" Foreground="White" FontSize="18" FontWeight="Bold" Padding="15,20,15,10"/>
            <Separator Background="#FF171D67" Height="1"/>

            <Button Content="Pacientes" Margin="10,15,10,5" Height="41" Width="176"/>
            <Button Content="Citas" Margin="10,5,10,5" Height="41" Width="176"/>
            <Button Content="Especialistas" Margin="10,5,10,5" Height="41" Width="176"/>
            <Button Content="Expedientes" Margin="10,5,10,5" Height="41" Width="176"/>

            <Separator Background="#FF4A4B7F" Height="1" Margin="0,20,0,0"/>
            <Button Content="Cerrar Sesión" Margin="10,15,10,5" Height="41" Width="176"/>
        </StackPanel>

        <Grid Grid.Column="1" Background="#F0F0F0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Border Grid.Row="0" Background="White" BorderThickness="0,0,0,2" BorderBrush="#FFE0E0E0">
                <TextBlock x:Name="TxtTitulo" Text="Bienvenida" Foreground="#FF171D67" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="30,0,0,0"/>
            </Border>

            <Frame x:Name="ContenidoPrincipal" Grid.Row="1" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>