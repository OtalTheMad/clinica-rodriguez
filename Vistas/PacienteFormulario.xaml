<UserControl x:Class="ClinicaRodriguez.Vistas.PacienteFormulario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="TituloSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#171D67"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="LabelCampo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CajaTexto" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#171D67"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F5F9" Margin="18">
        <Border Background="White"
                CornerRadius="8"
                Padding="22"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                VerticalAlignment="Top">

            <StackPanel>
                <TextBlock Text="Registrar nuevo paciente"
                           Style="{StaticResource TituloSeccion}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Nombre" Style="{StaticResource LabelCampo}"/>
                        <TextBox Text="{Binding Paciente.Nombre, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CajaTexto}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                        <TextBlock Text="Apellido" Style="{StaticResource LabelCampo}"/>
                        <TextBox Text="{Binding Paciente.Apellido, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CajaTexto}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="DNI" Style="{StaticResource LabelCampo}"/>
                        <TextBox Text="{Binding Paciente.DNI, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CajaTexto}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                        <TextBlock Text="Teléfono principal" Style="{StaticResource LabelCampo}"/>
                        <TextBox Text="{Binding Paciente.TelefonoPrimario, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CajaTexto}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Correo" Style="{StaticResource LabelCampo}"/>
                        <TextBox Text="{Binding Paciente.Correo, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CajaTexto}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                        <TextBlock Text="Fecha de nacimiento" Style="{StaticResource LabelCampo}"/>
                        <DatePicker SelectedDate="{Binding Paciente.FechaNacimiento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Height="34"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Residencia" Style="{StaticResource LabelCampo}"/>
                        <TextBox Text="{Binding Paciente.Residencia, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CajaTexto}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">
                        <TextBlock Text="Ocupación" Style="{StaticResource LabelCampo}"/>
                        <TextBox Text="{Binding Paciente.Ocupacion, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CajaTexto}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">

                    <Button Content="Guardar y abrir expediente"
                            Style="{StaticResource BotonPrincipal}"
                            Command="{Binding GuardarPacienteCommand}"/>

                    <Button Content="Cancelar"
                            Height="36"
                            Padding="16,0"
                            Command="{Binding CancelarCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>