<Window x:Class="ClinicaRodriguez.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClinicaRodriguez"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF0A1470" Offset="0"/>
                    <GradientStop Color="#FF5E66C3" Offset="0.3"/>
                    <GradientStop Color="#FF5F6FF3" Offset="0.7"/>
                    <GradientStop Color="#FF0A1169" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Grid.Column="1" HorizontalAlignment="Center" Height="345" Margin="0,39,0,0" Grid.RowSpan="2" VerticalAlignment="Top" Width="352" Source="/logo.png" StretchDirection="DownOnly"/>
            <Label Content="INICIAR SESION" HorizontalAlignment="Left" Height="83" Margin="103,44,0,0" Grid.RowSpan="2" VerticalAlignment="Top" Width="304" FontFamily="Sans Serif Collection" FontSize="36" Grid.ColumnSpan="2"/>
            <TextBox HorizontalAlignment="Left" Margin="135,157,0,0" 
                    TextWrapping="Wrap" Text="" VerticalAlignment="Top" 
                    Width="242" Height="32"
                    Background="#F0F0F0"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Padding="8,5">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </TextBox.Resources>
                <UIElement.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </UIElement.RenderTransform>
            </TextBox>
            <PasswordBox HorizontalAlignment="Left" Margin="134,217,0,0" Grid.Row="0" 
                        VerticalAlignment="Top" Width="242" Height="31"
                        Background="#F0F0F0"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Padding="8,5">
                <PasswordBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </PasswordBox.Resources>
            </PasswordBox>
            <Image HorizontalAlignment="Left" Height="32" Margin="98,157,0,0" Grid.RowSpan="2" VerticalAlignment="Top" Width="34" RenderTransformOrigin="-0.004,0.452" Source="/usuario.png"/>
            <Image HorizontalAlignment="Left" Height="32" Margin="97,216,0,0" Grid.RowSpan="2" VerticalAlignment="Top" Width="34" RenderTransformOrigin="-0.004,0.452" Source="/contrasena.png"/>
            <Button Content="Iniciar Sesion" HorizontalAlignment="Left" Margin="164,34,0,0" Grid.Row="1" VerticalAlignment="Top" Height="46" Width="137" FontFamily="Arial Rounded MT Bold" FontSize="18" RenderTransformOrigin="0.515,0.116"/>

        </Grid>

    </Grid>
</Window>